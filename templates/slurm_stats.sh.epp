<%- | $source_path,
| -%>
#!/bin/bash
# This file is managed by Puppet

## Author: JD Maloney | NCSA ##

source <%= $source_path %>

# Pre-run cleanup in case previous run(s) exited before cleanup process
rm -f /tmp/tig_slurm_stats.*

partitions=($("${slurm_path}"/sinfo -h | awk '{print $1}' | sort -u | xargs | sed 's/*//g'))

## Get data
tfile1=$(mktemp /tmp/tig_slurm_stats.XXXXXX)
tfile2=$(mktemp /tmp/tig_slurm_stats.XXXXXX)
tfile3=$(mktemp /tmp/tig_slurm_stats.XXXXXX)
"${slurm_path}"/squeue -a -h -l > ${tfile1}
"${slurm_path}"/squeue -h -l -O Partition:100,Username:50,State | awk '{ n=split($1,a,","); for(i=1;i<=n;i++) print a[i], $2, $3 }' > "${tfile2}"
"${slurm_path}"/sinfo -o %R,%D,%T | tr -cd '[:alnum:],-_\n' > "${tfile3}"

##Aggregate Node Stats
IFS="/" read nodes_busy nodes_idle nodes_offline nodes_total <<< "$("${slurm_path}"/sinfo -h -o %F)"

echo "slurm_nodesumdata,partition=all,type=busy count=${nodes_busy}"
echo "slurm_nodesumdata,partition=all,type=idle count=${nodes_idle}"
echo "slurm_nodesumdata,partition=all,type=offline count=${nodes_offline}"
echo "slurm_nodesumdata,partition=all,type=total count=${nodes_total}"

total_jobs=$(cat ${tfile1} | wc -l)
running_jobs=$(grep RUNNING ${tfile1} | wc -l )
pending_jobs=$(grep PENDING ${tfile1} | wc -l )
max_jobs=$("${slurm_path}"/scontrol show config | grep MaxJobCount | cut -d' ' -f 15)
percent_max=$(echo "${total_jobs} / ${max_jobs} *100" | bc -l)

echo "slurm_jobsumdata,partition=all,type=running count=${running_jobs}"
echo "slurm_jobsumdata,partition=all,type=pending count=${pending_jobs}"
echo "slurm_jobsumdata,partition=all,type=total count=${total_jobs}"
echo "slurm_jobsumdata,partition=all,type=max_jobs count=${max_jobs}"
echo "slurm_jobsumdata,partition=all,type=percent_of_max_jobs count=${percent_max}"

pend_line="slurm_jobsumdata,partition=all,type=pendingbyreason "
found_pending=0
while IFS= read -r line; do
  found_pending=1
  IFS=" " read -r pend_job_count pend_reason <<< "${line}"
  pend_line="${pend_line},${pend_reason}=${pend_job_count}"
done < <(awk '{print $9}' ${tfile1} | awk '$1 ~ /\(/ {print $0}' | sort | uniq -c | sed 's/^ *//g' | tr -d '()' | sed 's/,//g')
if [ ${found_pending} -eq 1 ]; then
  final_pend_line=$(echo ${pend_line} | sed 's/\ ,/\ /')
  echo "${final_pend_line}"
fi

for p in ${partitions[@]}
do
  read -r total_jobs running_jobs pending_jobs < <(awk -v p="$p" ' $1 == p {total++; if ($3 == "RUNNING") running++; else if ($3 == "PENDING") pending++; } END { print total+0, running+0, pending+0 }' ${tfile2})

  echo "slurm_jobsumdata,partition=$p,type=running count=${running_jobs}"
  echo "slurm_jobsumdata,partition=$p,type=pending count=${pending_jobs}"
  echo "slurm_jobsumdata,partition=$p,type=total count=${total_jobs}"

  awk -v partition="$p" '$2==partition && $9~/\(/ { reason=$9; gsub(/[(),]/,"",reason); count[reason]++ } END { if(length(count)) { printf "slurm_jobsumdata,partition=%s,type=pendingbyreason ",partition; sep=""; for(reason in count) { printf "%s%s=%d",sep,reason,count[reason]; sep="," } printf "\n" } }' "$tfile1"

  awk -F',' -v partition="$p" '$1==partition { count[$3]+=$2 } END { if(length(count)){ printf "slurm_partition_node_state,partition=%s ",partition; first=1; for(state in count){ if(!first) printf ","; printf "%s=%d",state,count[state]; first=0 } printf "\n" } else printf "slurm_partition_node_state,partition=%s idle=0\n",partition }' "$tfile3"

  IFS="/" read -r alloc_nodes idle_nodes offline_nodes total_nodes <<< "$("${slurm_path}"/sinfo -h --partition="$p" -o %F)"

  if [ -z "${alloc_nodes}" ]; then
    percent_offline=0
    offline_nodes=0
    alloc_nodes=0
    idle_nodes=0
    total_nodes=0

  else
    percent_offline=$(echo "${offline_nodes} / ${total_nodes} * 100" | bc -l)
  fi
  echo "slurm_nodedata,partition=$p,type=offline count=${offline_nodes}"
  echo "slurm_nodedata,partition=$p,type=busy count=${alloc_nodes}"
  echo "slurm_nodedata,partition=$p,type=idle count=${idle_nodes}"
  echo "slurm_nodedata,partition=$p,type=total count=${total_nodes}"
  echo "slurm_nodedata,partition=$p,type=percent_offline percent=${percent_offline}"

  if [ ${total_jobs} -ne 0 ]; then
    users=($(awk '{print $2}' ${tfile2} | sort -u))
    for u in ${users[@]}
    do
            awk -v p="$p" -v u="$u" '$1 == p && $2 == u && ($3 == "RUNNING" || $3 == "PENDING") { count[$2,$3]++ } END { for (key in count) { split(key, a, SUBSEP); printf "slurm_userjobdata,partition=%s,type=%s,uname=%s count=%d\n", p, tolower(a[2]), a[1], count[key] } }' "${tfile2}"
    done
  fi
done

## Backfill & Scheduler Stats
counters=$(${slurm_path}/sdiag --json | awk '/server_thread_count/ {found=1} found' | awk '/bf_when_last_cycle/{exit} {print}' | sed -z 's/{[^{}]*}/{}/g' | grep -v "{" | sed 's/"//g' | sed 's/\ //g' | sed 's/,//g' | sed 's/^/slurm_/' | sed 's/bf/backfill/' | sed 's/schedule_cycle/cycles/' | sed 's/:/=/' | xargs | sed 's/\ /,/g')

echo "slurm_scheduler_data ${counters}"

rm -f /tmp/tig_slurm_stats.*
